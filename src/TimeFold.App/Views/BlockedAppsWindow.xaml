<Window x:Class="TimeFold.App.Views.BlockedAppsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TimeFold - Blocked apps"
        Height="680"
        Width="900"
        MinHeight="460"
        MinWidth="700"
        WindowStartupLocation="CenterOwner"
        Background="White">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ================= Header ================= -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Blocked apps"
                       FontSize="24"
                       FontWeight="SemiBold" />
            <TextBlock Text="Tick an app to stop recording it. Blocked apps are never written to the database - not hidden, never saved."
                       FontSize="13"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource TextMuted}"
                       Margin="0,2,0,0" />
        </StackPanel>

        <TabControl Grid.Row="1" BorderBrush="{StaticResource BorderColour}">

            <!-- ============================================================
                 TAB 1 - your apps
                 ============================================================ -->
            <TabItem Header="Your apps">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Search and filter -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="SearchBox"
                                 Grid.Column="0"
                                 Padding="8,6"
                                 VerticalContentAlignment="Center"
                                 TextChanged="OnSearchChanged" />

                        <CheckBox x:Name="ShowBlockedOnlyBox"
                                  Grid.Column="1"
                                  Content="Blocked only"
                                  VerticalAlignment="Center"
                                  Margin="12,0,12,0"
                                  Checked="OnFilterChanged"
                                  Unchecked="OnFilterChanged" />

                        <Button x:Name="RescanButton"
                                Grid.Column="2"
                                Content="Rescan apps"
                                Padding="14,7"
                                Click="OnRescanClicked" />
                    </Grid>

                    <Border Grid.Row="1"
                            BorderBrush="{StaticResource BorderColour}"
                            BorderThickness="1"
                            CornerRadius="4">
                        <Grid>
                            <ListView x:Name="AppsList"
                                      BorderThickness="0"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Blocked" Width="70">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding IsBlocked, Mode=OneWay}"
                                                              Checked="OnAppBlockToggled"
                                                              Unchecked="OnAppBlockToggled"
                                                              Tag="{Binding ExeFileName}"
                                                              HorizontalAlignment="Center" />
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>

                                        <GridViewColumn Header="App"
                                                        Width="260"
                                                        DisplayMemberBinding="{Binding DisplayName}" />

                                        <GridViewColumn Header="Program file"
                                                        Width="200"
                                                        DisplayMemberBinding="{Binding ExeFileName}" />

                                        <GridViewColumn Header="Found in"
                                                        Width="130"
                                                        DisplayMemberBinding="{Binding FoundIn}" />

                                        <GridViewColumn Header="Status"
                                                        Width="140"
                                                        DisplayMemberBinding="{Binding StatusText}" />
                                    </GridView>
                                </ListView.View>
                            </ListView>

                            <TextBlock x:Name="AppsMessage"
                                       Text="Looking for your apps..."
                                       Foreground="{StaticResource TextMuted}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ============================================================
                 TAB 2 - advanced rules
                 ============================================================ -->
            <TabItem Header="Advanced rules">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="{StaticResource PanelBackground}"
                            BorderBrush="{StaticResource BorderColour}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="12"
                            Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="For anything the app list cannot cover: a whole folder, or private words in a window title."
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource TextMuted}"
                                       Margin="0,0,0,10" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <ComboBox x:Name="MatchTypeBox"
                                          Grid.Column="0"
                                          Width="200"
                                          Padding="8,6"
                                          VerticalContentAlignment="Center"
                                          SelectionChanged="OnMatchTypeChanged" />

                                <TextBox x:Name="PatternBox"
                                         Grid.Column="1"
                                         Margin="8,0,8,0"
                                         Padding="8,6"
                                         VerticalContentAlignment="Center"
                                         KeyDown="OnPatternKeyDown" />

                                <Button x:Name="AddButton"
                                        Grid.Column="2"
                                        Content="Add rule"
                                        Padding="16,7"
                                        Click="OnAddClicked" />
                            </Grid>

                            <TextBlock x:Name="HelpText"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource TextMuted}"
                                       Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1"
                            BorderBrush="{StaticResource BorderColour}"
                            BorderThickness="1"
                            CornerRadius="4">
                        <Grid>
                            <ListView x:Name="RulesList"
                                      BorderThickness="0"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="On" Width="50">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding IsEnabled, Mode=OneWay}"
                                                              Checked="OnRuleToggled"
                                                              Unchecked="OnRuleToggled"
                                                              Tag="{Binding Id}"
                                                              HorizontalAlignment="Center" />
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>

                                        <GridViewColumn Header="Matches on"
                                                        Width="160"
                                                        DisplayMemberBinding="{Binding MatchTypeText}" />

                                        <GridViewColumn Header="Pattern"
                                                        Width="250"
                                                        DisplayMemberBinding="{Binding Pattern}" />

                                        <GridViewColumn Header="Note"
                                                        Width="220"
                                                        DisplayMemberBinding="{Binding Note}" />

                                        <GridViewColumn Header="From"
                                                        Width="80"
                                                        DisplayMemberBinding="{Binding SourceText}" />
                                    </GridView>
                                </ListView.View>
                            </ListView>

                            <TextBlock x:Name="EmptyMessage"
                                       Text="No rules yet."
                                       Foreground="{StaticResource TextMuted}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Visibility="Collapsed" />
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- ================= Footer ================= -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="StatusText"
                       Grid.Column="0"
                       FontSize="12"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource TextMuted}" />

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="DeleteButton"
                        Content="Delete selected rule"
                        Padding="14,7"
                        Margin="0,0,8,0"
                        Click="OnDeleteClicked" />
                <Button Content="Close"
                        Padding="14,7"
                        Click="OnCloseClicked" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>

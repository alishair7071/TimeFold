<Application x:Class="TimeFold.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">

    <!--
        ShutdownMode="OnExplicitShutdown" is important.

        By default a WPF app closes when its last window closes. TimeFold must
        keep running with no window open at all, so we tell WPF to shut down
        only when we say so - which happens when you click Quit in the tray menu.
    -->

    <Application.Resources>
        <SolidColorBrush x:Key="TextMuted" Color="#6B7280" />
        <SolidColorBrush x:Key="PanelBackground" Color="#F9FAFB" />
        <SolidColorBrush x:Key="BorderColour" Color="#E5E7EB" />
        <SolidColorBrush x:Key="AccentGreen" Color="#15803D" />
        <SolidColorBrush x:Key="AccentAmber" Color="#B45309" />
    </Application.Resources>

</Application>

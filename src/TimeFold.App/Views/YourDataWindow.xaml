<Window x:Class="TimeFold.App.Views.YourDataWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TimeFold - Your data"
        Height="560"
        Width="720"
        MinHeight="460"
        MinWidth="600"
        WindowStartupLocation="CenterOwner"
        Background="White">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ================= Header ================= -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Your data"
                       FontSize="24"
                       FontWeight="SemiBold" />
            <TextBlock x:Name="SummaryText"
                       FontSize="13"
                       Foreground="{StaticResource TextMuted}"
                       Margin="0,2,0,0" />
        </StackPanel>

        <!-- ================= Export ================= -->
        <Border Grid.Row="1"
                Background="{StaticResource PanelBackground}"
                BorderBrush="{StaticResource BorderColour}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="14"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="Take a copy" FontWeight="SemiBold" />
                    <TextBlock Text="Writes everything to a plain JSON file you can open in Notepad or load anywhere else. Do this before deleting anything."
                               FontSize="12"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource TextMuted}"
                               Margin="0,4,0,0" />
                </StackPanel>

                <Button Grid.Column="1"
                        Content="Export..."
                        Padding="18,8"
                        VerticalAlignment="Center"
                        Click="OnExportClicked" />
            </Grid>
        </Border>

        <!-- ================= Restore ================= -->
        <Border Grid.Row="2"
                Background="{StaticResource PanelBackground}"
                BorderBrush="{StaticResource BorderColour}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="14"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="Restore from a copy" FontWeight="SemiBold" />
                    <TextBlock Text="Adds the records from an export file back. Nothing already here is lost, and importing the same file twice is harmless."
                               FontSize="12"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource TextMuted}"
                               Margin="0,4,0,0" />
                </StackPanel>

                <Button Grid.Column="1"
                        Content="Restore..."
                        Padding="18,8"
                        VerticalAlignment="Center"
                        Click="OnImportClicked" />
            </Grid>
        </Border>

        <!-- ================= Delete ================= -->
        <Border Grid.Row="3"
                BorderBrush="#FCA5A5"
                BorderThickness="1"
                CornerRadius="4"
                Padding="14">
            <StackPanel>
                <TextBlock Text="Delete" FontWeight="SemiBold" />
                <TextBlock Text="Deleting cannot be undone. Your block rules and settings are kept."
                           FontSize="12"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource TextMuted}"
                           Margin="0,4,0,10" />

                <StackPanel Orientation="Horizontal">
                    <Button Content="Delete today"
                            Padding="14,7"
                            Margin="0,0,8,0"
                            Click="OnDeleteTodayClicked" />
                    <Button Content="Delete a day..."
                            Padding="14,7"
                            Margin="0,0,8,0"
                            Click="OnDeleteChosenDayClicked" />
                    <Button x:Name="DeleteEverythingButton"
                            Content="Delete everything"
                            Padding="14,7"
                            Foreground="#B91C1C"
                            Click="OnDeleteEverythingClicked" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <DatePicker x:Name="DayPicker"
                                Width="150"
                                VerticalContentAlignment="Center" />
                    <TextBlock Text="Pick a date, then use &quot;Delete a day&quot;."
                               FontSize="12"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0"
                               Foreground="{StaticResource TextMuted}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ================= Result ================= -->
        <TextBlock x:Name="StatusText"
                   Grid.Row="4"
                   FontSize="12"
                   TextWrapping="Wrap"
                   VerticalAlignment="Top"
                   Margin="0,14,0,0"
                   Foreground="{StaticResource TextMuted}" />

        <!-- ================= Footer ================= -->
        <Button Grid.Row="5"
                Content="Close"
                Padding="18,8"
                HorizontalAlignment="Right"
                Click="OnCloseClicked" />
    </Grid>
</Window>

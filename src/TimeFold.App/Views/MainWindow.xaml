<Window x:Class="TimeFold.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TimeFold - Today"
        Height="640"
        Width="980"
        MinHeight="400"
        MinWidth="700"
        WindowStartupLocation="CenterScreen"
        Background="White">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ================= Header ================= -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Today"
                           FontSize="24"
                           FontWeight="SemiBold" />
                <TextBlock x:Name="DateText"
                           FontSize="13"
                           Foreground="{StaticResource TextMuted}"
                           Margin="0,2,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="PauseButton"
                        Content="Pause recording"
                        Padding="14,7"
                        Margin="0,0,8,0"
                        Click="OnPauseButtonClicked" />
                <Button Content="Blocked apps"
                        Padding="14,7"
                        Margin="0,0,8,0"
                        Click="OnBlockedAppsButtonClicked" />
                <Button Content="Your data"
                        Padding="14,7"
                        Margin="0,0,8,0"
                        Click="OnYourDataButtonClicked" />
                <Button Content="Refresh"
                        Padding="14,7"
                        Click="OnRefreshButtonClicked" />
            </StackPanel>
        </Grid>

        <!-- ================= Status strip ================= -->
        <Border Grid.Row="1"
                Background="{StaticResource PanelBackground}"
                BorderBrush="{StaticResource BorderColour}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12,10"
                Margin="0,0,0,12">
            <TextBlock x:Name="StatusText" FontSize="13" />
        </Border>

        <!-- ================= The list ================= -->
        <Border Grid.Row="2"
                BorderBrush="{StaticResource BorderColour}"
                BorderThickness="1"
                CornerRadius="6">
            <Grid>
                <ListView x:Name="ActivityList"
                          BorderThickness="0"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <!-- Right-click a line to deal with just that line. -->
                    <ListView.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Delete this entry"
                                      Click="OnDeleteEntryClicked" />
                            <MenuItem Header="Delete everything from this app"
                                      Click="OnDeleteAppHistoryClicked" />
                            <Separator />
                            <MenuItem Header="Never record this app again"
                                      Click="OnBlockAppClicked" />
                        </ContextMenu>
                    </ListView.ContextMenu>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Time" Width="150"
                                            DisplayMemberBinding="{Binding TimeRange}" />
                            <GridViewColumn Header="Length" Width="90"
                                            DisplayMemberBinding="{Binding Duration}" />
                            <GridViewColumn Header="Application" Width="200"
                                            DisplayMemberBinding="{Binding AppName}" />
                            <GridViewColumn Header="Window title" Width="460"
                                            DisplayMemberBinding="{Binding WindowTitle}" />
                        </GridView>
                    </ListView.View>
                </ListView>

                <!-- Shown instead of the list when there is nothing recorded yet. -->
                <TextBlock x:Name="EmptyMessage"
                           Text="Nothing recorded yet today.&#x0a;&#x0a;TimeFold is watching. Switch to another application and come back."
                           TextAlignment="Center"
                           Foreground="{StaticResource TextMuted}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="Collapsed" />
            </Grid>
        </Border>

        <!-- ================= Footer ================= -->
        <TextBlock Grid.Row="3"
                   x:Name="FooterText"
                   FontSize="11"
                   Foreground="{StaticResource TextMuted}"
                   Margin="0,10,0,0" />
    </Grid>
</Window>

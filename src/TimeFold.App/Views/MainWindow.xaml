<Window x:Class="TimeFold.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TimeFold - Today"
        Height="640"
        Width="980"
        MinHeight="400"
        MinWidth="700"
        WindowStartupLocation="CenterScreen"
        Background="White">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ================= Header ================= -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock x:Name="HeadingText"
                           Text="Today"
                           FontSize="24"
                           FontWeight="SemiBold" />
                <TextBlock x:Name="DateText"
                           FontSize="13"
                           Foreground="{StaticResource TextMuted}"
                           Margin="0,2,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="PauseButton"
                        Content="Pause recording"
                        Padding="14,7"
                        Margin="0,0,8,0"
                        Click="OnPauseButtonClicked" />
                <Button Content="Blocked apps"
                        Padding="14,7"
                        Margin="0,0,8,0"
                        Click="OnBlockedAppsButtonClicked" />
                <Button Content="Your data"
                        Padding="14,7"
                        Margin="0,0,8,0"
                        Click="OnYourDataButtonClicked" />
                <Button Content="Refresh"
                        Padding="14,7"
                        Click="OnRefreshButtonClicked" />
            </StackPanel>
        </Grid>

        <!-- ================= Go to a day, or search ================= -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button x:Name="PreviousDayButton"
                    Grid.Column="0"
                    Content="&#x25C0;"
                    ToolTip="The day before"
                    Padding="12,7"
                    Click="OnPreviousDayClicked" />

            <DatePicker x:Name="DayPicker"
                        Grid.Column="1"
                        Width="140"
                        Margin="6,0,6,0"
                        VerticalContentAlignment="Center"
                        SelectedDateChanged="OnDayPicked" />

            <Button x:Name="NextDayButton"
                    Grid.Column="2"
                    Content="&#x25B6;"
                    ToolTip="The day after"
                    Padding="12,7"
                    Click="OnNextDayClicked" />

            <Button Grid.Column="3"
                    Content="Today"
                    Padding="12,7"
                    Margin="6,0,0,0"
                    Click="OnTodayClicked" />

            <Rectangle Grid.Column="4"
                       Width="1"
                       Margin="14,2,14,2"
                       Fill="{StaticResource BorderColour}" />

            <TextBox x:Name="SearchBox"
                     Grid.Column="5"
                     Padding="8,6"
                     VerticalContentAlignment="Center"
                     TextChanged="OnSearchTextChanged"
                     ToolTip="Search every day you have ever recorded" />

            <Button x:Name="ClearSearchButton"
                    Grid.Column="6"
                    Content="Clear search"
                    Padding="12,7"
                    Margin="6,0,0,0"
                    Click="OnClearSearchClicked" />
        </Grid>

        <!-- ================= Status strip ================= -->
        <Border Grid.Row="2"
                Background="{StaticResource PanelBackground}"
                BorderBrush="{StaticResource BorderColour}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12,10"
                Margin="0,0,0,12">
            <TextBlock x:Name="StatusText" FontSize="13" />
        </Border>

        <!-- ================= The list ================= -->
        <Border Grid.Row="3"
                BorderBrush="{StaticResource BorderColour}"
                BorderThickness="1"
                CornerRadius="6">
            <Grid>
                <ListView x:Name="ActivityList"
                          BorderThickness="0"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <!-- Right-click a line to deal with just that line. -->
                    <ListView.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Delete this entry"
                                      Click="OnDeleteEntryClicked" />
                            <MenuItem Header="Delete everything from this app"
                                      Click="OnDeleteAppHistoryClicked" />
                            <Separator />
                            <MenuItem Header="Never record this app again"
                                      Click="OnBlockAppClicked" />
                        </ContextMenu>
                    </ListView.ContextMenu>
                    <!--
                        Grouped by hour. Thirty lines in a row all say the same
                        thing; "2 PM" above them says when, which is the question
                        this window exists to answer.
                    -->
                    <ListView.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource PanelBackground}"
                                            BorderBrush="{StaticResource BorderColour}"
                                            BorderThickness="0,0,0,1"
                                            Padding="10,6">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}"
                                                       FontWeight="SemiBold"
                                                       FontSize="13" />
                                            <TextBlock Text="{Binding ItemCount, StringFormat=  ({0})}"
                                                       FontSize="12"
                                                       Margin="6,0,0,0"
                                                       VerticalAlignment="Center"
                                                       Foreground="{StaticResource TextMuted}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListView.GroupStyle>

                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Time" Width="150"
                                            DisplayMemberBinding="{Binding TimeRange}" />
                            <GridViewColumn Header="Length" Width="90"
                                            DisplayMemberBinding="{Binding Duration}" />
                            <GridViewColumn Header="Application" Width="200"
                                            DisplayMemberBinding="{Binding AppName}" />
                            <GridViewColumn Header="Window title" Width="460"
                                            DisplayMemberBinding="{Binding WindowTitle}" />
                        </GridView>
                    </ListView.View>
                </ListView>

                <!-- Shown instead of the list when there is nothing recorded yet. -->
                <TextBlock x:Name="EmptyMessage"
                           Text="Nothing recorded yet today.&#x0a;&#x0a;TimeFold is watching. Switch to another application and come back."
                           TextAlignment="Center"
                           Foreground="{StaticResource TextMuted}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="Collapsed" />
            </Grid>
        </Border>

        <!-- ================= Footer ================= -->
        <TextBlock Grid.Row="4"
                   x:Name="FooterText"
                   FontSize="11"
                   Foreground="{StaticResource TextMuted}"
                   Margin="0,10,0,0" />
    </Grid>
</Window>
